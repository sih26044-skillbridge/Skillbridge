# SkillBridge Backend Environment Configuration
PORT=8000
NODE_ENV=development

# PostgreSQL Connection (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge

# JWT Secrets
JWT_SECRET=skillbridge-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# File uploads directory (relative to backend root)
UPLOAD_DIR=uploads

# CORS - allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
